    {
      "id": "bus",
      "type": "broker",
      "name": "Шина проверенного",
      "x": 560,
      "y": 700,
      "enabled": true,
      "notes": "Развязка приёма и списания: решение «шина вместо прямого вызова».",
      "params": {
        "topic": "intake.checked",
        "transport": "rabbitmq",
        "schema": "{ trace_id, kind: order|payment, id, payload }",
        "schema_version": "1.2.0",
        "compat": "backward",
        "versions_live": 2,
        "on_unknown": "ignore_unknown",
        "group": "charger",
        "ack": "manual",
        "visibility_s": 60,
        "prefetch": 16,
        "max_attempts": 5,
        "ordering": "by_key",
        "partition_key": "id",
        "retention_h": 168,
        "unit": "bus"
      }
    },
    {
      "id": "dlq",
      "type": "dlq",
      "name": "Изолятор приёма",
      "x": 800,
      "y": 700,
      "enabled": true,
      "notes": "Сюда уходит то, что не прошло пять попыток. Без него отказ одного элемента останавливал бы поток.",
      "params": {
        "name": "intake-dlq",
        "store": "postgres",
        "keep": [
