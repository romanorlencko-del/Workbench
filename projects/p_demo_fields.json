      "name": "Разбор изолятора",
      "x": 800,
      "y": 560,
      "enabled": true,
      "notes": "Бесшовное лечение: работает своим темпом и не требует остановки потока.",
      "params": {
        "source": "intake-dlq",
        "trigger": "cron",
        "cron": "0 * * * *",
        "batch": 50,
        "rate_per_min": 120,
        "action": "republish",
        "target_topic": "intake.checked",
        "fix": "починить кодировку и недостающие необязательные поля; остальное оставить в изоляторе",
        "on_error": "fail",
        "unit": "bus"
      }
    },
