            "name": "amount",
            "kind": "money",
            "required": true,
            "note": "в копейках"
          },
          {
            "name": "status",
            "kind": "enum",
            "values": [
              "new",
              "held",
              "charged",
              "failed"
            ],
            "required": true
          }
        ]
      }
