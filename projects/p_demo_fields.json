        "key": "payment",
        "vars": [
          "ctx.payment",
          "ctx.payment_checked",
          "ctx.payment_charged"
        ],
        "id_field": "id",
        "owner": "billing",
        "fields": [
          {
            "name": "id",
            "kind": "string",
            "required": true
          },
          {
            "name": "order",
            "kind": "ref",
            "ref": "order",
            "required": true,
            "note": "какой заказ оплачивают"
          },
