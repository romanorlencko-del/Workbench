        "breaker": "on",
        "breaker_threshold": 50,
        "breaker_window": 20,
        "breaker_open_s": 30,
        "breaker_probe": 1,
        "breaker_fallback": "queue",
        "unit": "billing",
        "publish_mode": "none",
        "rps": 20,
        "peak_factor": 2,
        "rps_one": 25,
        "latency_ms": 400,
        "payload_kb": 2
