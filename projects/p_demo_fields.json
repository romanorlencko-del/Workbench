      "id": "dec_bus",
      "type": "decision",
      "name": "Шина",
      "x": 460,
      "y": 200,
      "enabled": true,
      "notes": "",
      "params": {
        "title": "шина вместо прямого вызова",
        "status": "accepted",
        "date": "2026-07-29",
        "affects": [
          "intake",
          "billing"
        ],
        "context": "пик заказов валил биллинг, и вместе с ним останавливался приём",
        "rejected": "прямой вызов с повторами — падение биллинга всё равно останавливает приём;\nобщая база на два контура — снимает изоляцию, ради которой их и разделили",
        "costs": "согласованность стала отложенной; появился изолятор, за которым надо следить",
        "revisit": "если поток упадёт ниже 5/с — шина станет дороже пользы"
      }
    },
    {
      "id": "dec_kopeck",
      "type": "decision",
      "name": "Копейки",
      "x": 660,
      "y": 200,
      "enabled": true,
      "notes": "",
      "params": {
        "title": "суммы целыми копейками",
        "status": "accepted",
        "date": "2026-07-29",
        "affects": [
          "order",
          "payment"
        ],
        "context": "на сверке расходились итоги: дробные рубли округлялись по-разному в двух местах",
        "rejected": "дробные рубли — округления расходятся;\ndecimal-строки — каждый парсит по-своему",
        "costs": "везде делить на 100 при показе человеку",
        "revisit": "если появятся валюты без сотых долей"
      }
