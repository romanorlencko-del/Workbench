        "retention_days": 14,
        "alert_after": 100,
        "unit": "bus",
        "env_over": [
          {
            "env": "dev",
            "key": "retention_days",
            "value": "2",
            "why": "ноутбуку хватит двух дней"
          }
        ]
      }
    },
