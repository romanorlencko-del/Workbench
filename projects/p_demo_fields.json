      "type": "process",
      "name": "Списание",
      "x": 560,
      "y": 860,
      "enabled": true,
      "notes": "Держатель денег: берёт сумму платежа и статус заказа, ходит во внешний шлюз.",
      "params": {
        "op": "enrich",
        "rule": "провести списание через шлюз и записать результат в статус платежа",
