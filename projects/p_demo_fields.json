    {
      "id": "entity_order",
      "type": "entity",
      "name": "Заказ",
      "x": 40,
      "y": 200,
      "enabled": true,
      "notes": "",
      "params": {
        "key": "order",
        "vars": [
          "ctx.order",
          "ctx.order_checked"
        ],
        "id_field": "id",
        "owner": "intake",
        "fields": [
          {
            "name": "id",
            "kind": "string",
            "required": true,
            "note": "uuid, приходит от источника"
          },
          {
            "name": "total",
            "kind": "money",
            "required": true,
            "note": "в копейках, без НДС"
          },
          {
            "name": "status",
            "kind": "enum",
            "values": [
              "new",
              "checked",
              "paid"
            ],
            "required": true
          },
          {
            "name": "created_at",
            "kind": "ts",
            "required": true
          }
        ]
      }
    },
    {
      "id": "entity_payment",
