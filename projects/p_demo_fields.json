        "api_key_env": "GONKA_API_KEY",
        "context_tokens": 160000,
        "max_output_tokens": 16384
      },
      "heavy": {
        "label": "Тяжёлая",
        "provider": "openai-compatible",
        "base_url": "",
        "model": "glm-5.2",
        "api_key_env": "GLM_API_KEY",
        "context_tokens": 1000000,
        "max_output_tokens": 32768
      }
