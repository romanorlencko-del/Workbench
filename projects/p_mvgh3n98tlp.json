        "chunk_size": 800,
        "chunk_overlap": 120,
        "refresh": "manual",
        "interval_min": 60,
        "source": "https://en.wikipedia.org, https://ru.wikipedia.org, https://webbook.nist.gov, https://pubchem.ncbi.nlm.nih.gov"
